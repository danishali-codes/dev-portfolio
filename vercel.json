{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/found/:path*",
      "destination": "/"
    },
    {
      "source": "/files/:path*",
      "destination": "/"
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/"
    },
    {
      "source": "/wp-admin.php",
      "destination": "/"
    },
    {
      "source": "/wp-login.php",
      "destination": "/"
    },
    {
      "source": "/wp-login",
      "destination": "/"
    },
    {
      "source": "/wordpress/wp-admin/:path*",
      "destination": "/"
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-achievement",
          "value": "https://danishali.dev/found/headers"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "functions": {
    "api/github-stats.ts": {
      "maxDuration": 60
    }
  }
}
