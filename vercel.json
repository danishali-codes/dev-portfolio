{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/found/:path*",
      "destination": "/"
    },
    {
      "source": "/files/:path*",
      "destination": "/"
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/"
    },
    {
      "source": "/wp-admin.php",
      "destination": "/"
    },
    {
      "source": "/wp-login.php",
      "destination": "/"
    },
    {
      "source": "/wp-login",
      "destination": "/"
    },
    {
      "source": "/wordpress/wp-admin/:path*",
      "destination": "/"
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-achievement",
          "value": "https://danishali.dev/found/headers"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://raw.githubusercontent.com https://cdn.jsdelivr.net https://vercel.live https://vercel.com; media-src 'self' blob: https://raw.githubusercontent.com https://cdn.jsdelivr.net; font-src 'self' data: https://vercel.live; connect-src 'self' https://vercel.live wss://ws-us3.pusher.com; frame-src https://*.danishali.dev https://itch.io https://*.itch.io https://*.itch.zone https://vercel.live; object-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; manifest-src 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:file(favicon\\.ico|favicon\\.svg|icon-180\\.png|icon-192\\.png|icon-512\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "functions": {
    "api/github-stats.ts": {
      "maxDuration": 60
    }
  }
}
