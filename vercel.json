{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!fs/|assets/|favicon|api/|stats\\.json|robots\\.txt|sitemap\\.xml|og/|projects(?:/|$)|trash(?:/|$)|about(?:/|$)|contact(?:/|$)|cv(?:/|$)|now(?:/|$)|uses(?:/|$)|resume(?:/|$)|simple(?:/|$)|ask(?:/|$)|welcome(?:/|$)|stats(?:/|$)|terminal(?:/|$)|guestbook(?:/|$)|updates(?:/|$)|wallpaper(?:/|$)).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-achievement",
          "value": "https://danishali.dev/found/headers"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "functions": {
    "api/github-stats.ts": {
      "maxDuration": 60
    }
  }
}
